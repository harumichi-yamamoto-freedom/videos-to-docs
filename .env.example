# videos-to-docs の環境変数の雛形。
# ローカルでは `cp .env.example .env.local` して値を埋める (.env*.local は git 管理外)。
# 本番 (Vercel) では Settings → Environment Variables に Production / Preview の両方で入れる。
# このファイルには実際の値を書かない (public リポジトリ)。

# ----------------------------------------------------------------------
# Firebase Web 設定 (6 種)。NEXT_PUBLIC_ = ブラウザのバンドルに埋め込まれ閲覧者から見える。
# 公開前提の値 (Firestore/Storage Rules と API 制限で守る)。
# Firebase Console → プロジェクト設定 → マイアプリ → ウェブアプリ の値。
# ----------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----------------------------------------------------------------------
# サーバ専用 (NEXT_PUBLIC_ を付けない = ブラウザには出ない)。/api/generate だけが読む。
# ----------------------------------------------------------------------

# Gemini API キー (必須)。無いと /api/generate は 503 not_configured を返す。
# Google AI Studio (https://aistudio.google.com/app/apikey) で発行。
# 本番キーは「API 制限 = Generative Language API のみ」+ 1 日あたりの割当上限を設定する (docs/ops-runbook.md §5.5)。
# ローカルは本番と別のキーを使う。
GEMINI_API_KEY=

# Firebase サービスアカウント JSON (本番では必須)。
# /api/generate が ID トークン検証・Storage 読取・rateLimits の更新に使う。
# 値は次のどちらか:
#   (a) JSON をそのまま 1 行にしたもの: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}
#   (b) JSON ファイル全体を base64 にしたもの (改行を含む JSON を Vercel に貼るときはこちらが安全): base64 -i sa.json | tr -d '\n'
# 未設定なら Application Default Credentials にフォールバックする (ローカル開発・エミュレータ用。Vercel では設定必須)。
# 作り方 (最小権限) と Vercel への貼り方は docs/ops-runbook.md §5.6。
FIREBASE_SERVICE_ACCOUNT_JSON=

# ----------------------------------------------------------------------
# ローカル開発用: Firebase エミュレータ (firebase emulators:start --only auth,firestore,storage)。
# 設定されていれば firebase-admin は自動でエミュレータを向く (projectId は NEXT_PUBLIC_FIREBASE_PROJECT_ID)。
# Vercel には絶対に設定しない (本番のサーバがローカルアドレスを向いて全滅する)。
# ----------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ----------------------------------------------------------------------
# 廃止 (#4 でサーバ経由化)。設定しても読まれない。Vercel から削除し、旧キーは AI Studio で失効させる (docs/ops-runbook.md §5.4)。
# ----------------------------------------------------------------------
# NEXT_PUBLIC_GEMINI_API_KEY=   ← 廃止。ブラウザに配られていたため使わない
