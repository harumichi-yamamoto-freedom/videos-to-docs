rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 管理者判定（Firestore の superuser フィールドを参照）
    function isSuperuser() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.superuser == true;
    }

    match /audio/{ownerId}/{fileName} {
      // 読み取り:
      //   - ゲストファイル（ownerId == "GUEST"）は誰でも読み取り可
      //   - ログインユーザーは自分のファイルのみ
      //   - 管理者は全ファイル読み取り可
      allow read: if ownerId == "GUEST"
        || (request.auth != null && request.auth.uid == ownerId)
        || isSuperuser();

      // 所有者判定（ゲストは GUEST ディレクトリ、ログインユーザーは自分のディレクトリ）
      function isOwner() {
        return ownerId == "GUEST" || (request.auth != null && request.auth.uid == ownerId);
      }

      // 作成・更新:
      //   - ファイルサイズ上限: 100MB
      //   - content-type: audio/* のみ許可
      allow create, update: if isOwner()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      // 削除:
      // 🔴 `write` にまとめてはいけない。削除では `request.resource` が null になり、
      //    サイズと content-type の条件が評価できずに常に拒否される（実測: DELETE が 403）。
      //    その結果、ゲストが上げ直しても古いファイルが消えずに溜まり続けていた。
      allow delete: if isOwner();
    }
  }
}
