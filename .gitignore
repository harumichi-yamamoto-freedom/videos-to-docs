# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# .env.example だけを追跡する (実値を書かない雛形)。実値を持つ .env / .env.* は除外。
.env
.env.*
!.env.example
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# temporary files
/tmp
/temp
*.tmp

# Firebase service account keys
# 鍵はリポジトリ外 (~/.config 配下) に置き GOOGLE_APPLICATION_CREDENTIALS で指す
# (docs/ops-runbook.md §3)。ここは誤って置いたときの保険。
serviceAccountKey.json
*-firebase-adminsdk-*.json

# review-with-ai-agent
/pre-commit-review-v3
/measurement-01

# Claude Code
.claude/